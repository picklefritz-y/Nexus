# ============================================================
# Nexus — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Required ---

# Your Anthropic API key (get one at https://console.anthropic.com)
# Used for: claim extraction, theme detection, contradiction analysis
ANTHROPIC_API_KEY=sk-ant-...

# Database connection (default works with Docker Compose)
DATABASE_URL=postgresql://nexus:nexus_default_pw@localhost:5432/nexus

# --- Optional ---

# AssemblyAI API key (https://www.assemblyai.com — free tier available)
# Required only for podcast transcription via terminal script
ASSEMBLYAI_API_KEY=

# Semantic Scholar API key (https://www.semanticscholar.org/product/api)
# Optional — improves rate limits for paper lookups. Works without it.
SEMANTIC_SCHOLAR_API_KEY=

# --- Docker Compose Settings ---

# Password for the PostgreSQL database
DB_PASSWORD=nexus_default_pw

# Port the app runs on (default: 3000)
APP_PORT=3000

# Port for direct database access (default: 5432)
DB_PORT=5432
