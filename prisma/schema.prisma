// Nexus Knowledge Engine - Database Schema
// PostgreSQL via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Users
// ============================================================
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sources       Source[]
  reviewCards   ReviewCard[]
  reviewLogs    ReviewLog[]
  digests       Digest[]
  userThemes    UserTheme[]
  notes         Note[]

  @@map("users")
}

// ============================================================
// Sources — podcasts, papers, articles, books
// ============================================================
enum SourceType {
  PODCAST
  PAPER
  ARTICLE
  BOOK
}

enum ProcessingStatus {
  PENDING
  FETCHING
  EXTRACTING
  PROCESSING
  LINKING
  COMPLETE
  FAILED
}

model Source {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type             SourceType
  status           ProcessingStatus @default(PENDING)

  // Metadata
  title            String
  author           String?
  url              String?
  doi              String?          // For papers
  publicationDate  DateTime?
  addedAt          DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Extracted content
  rawText          String?          // Full transcript / extracted text
  summary          String?          // AI-generated summary
  keyTakeaways     String?          // JSON array of takeaway strings
  userNotes        String?          // User's personal notes & highlights

  // Podcast-specific
  podcastName      String?
  episodeNumber    String?
  durationSeconds  Int?
  transcriptSource String?          // "assemblyai" | "existing" | "manual"

  // Paper-specific
  journal          String?
  abstract         String?
  pdfUrl           String?
  semanticScholarId String?         // S2 paper ID for metadata enrichment

  // Processing metadata
  processingError  String?
  processingLog    String?          // JSON log of pipeline steps

  // Relations
  claims           ClaimSource[]
  themes           SourceTheme[]
  notes            Note[]
  deepResearchSources DeepResearchReportSource[]
  deepResearchCandidates DeepResearchCandidate[]

  @@index([userId])
  @@index([type])
  @@index([status])
  @@map("sources")
}

// ============================================================
// Domains — top-level organizational layer above Themes
// ============================================================
model Domain {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?  // emoji
  color       String?  // hex accent color
  createdAt   DateTime @default(now())
  isAutoGenerated Boolean @default(false)

  themes      Theme[]

  @@map("domains")
}

// ============================================================
// Themes — knowledge domains
// ============================================================
model Theme {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?  // emoji
  color       String?  // hex accent color
  bgColor     String?  // hex background tint
  createdAt   DateTime @default(now())

  // Auto-generated or manually curated
  isAutoGenerated Boolean @default(true)

  // Domain relationship
  domainId    String?
  domain      Domain?  @relation(fields: [domainId], references: [id], onDelete: SetNull)

  claims      ClaimTheme[]
  sources     SourceTheme[]
  userThemes  UserTheme[]
  notes       Note[]

  @@map("themes")
}

// User's relationship to themes (for custom ordering, preferences)
model UserTheme {
  id        String  @id @default(cuid())
  userId    String
  themeId   String
  sortOrder Int     @default(0)
  pinned    Boolean @default(false)

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme     Theme   @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([userId, themeId])
  @@map("user_themes")
}

model SourceTheme {
  id        String @id @default(cuid())
  sourceId  String
  themeId   String
  relevance Float  @default(1.0) // 0-1 how relevant this source is to this theme

  source    Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  theme     Theme   @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([sourceId, themeId])
  @@map("source_themes")
}

// ============================================================
// Claims — the atomic unit of knowledge
// ============================================================
enum ClaimStatus {
  CONSENSUS     // Multiple sources agree
  SUPPORTED     // At least one strong source
  EMERGING      // New, limited evidence
  CONTESTED     // Contradictory evidence exists
  CONTRADICTED  // Largely refuted by newer evidence
}

model Claim {
  id           String      @id @default(cuid())
  text         String      // The discrete claim statement
  status       ClaimStatus @default(EMERGING)
  confidence   Float       @default(0.5) // 0-1 aggregate confidence score
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // AI-generated context
  explanation  String?     // Longer explanation of the claim
  implications String?     // What this means practically
  methodology  String?     // How the evidence was gathered (for papers)

  // Relations
  sources      ClaimSource[]
  themes       ClaimTheme[]
  reviewCards  ReviewCard[]

  notes        Note[]

  // Contradiction tracking (self-referencing many-to-many)
  contradicts    Contradiction[] @relation("ClaimContradicts")
  contradictedBy Contradiction[] @relation("ClaimContradictedBy")

  // Supersession tracking
  supersedes     Supersession[]  @relation("ClaimSupersedes")
  supersededBy   Supersession[]  @relation("ClaimSupersededBy")

  @@index([status])
  @@map("claims")
}

model ClaimSource {
  id            String @id @default(cuid())
  claimId       String
  sourceId      String
  extractedText String? // The specific passage that supports this claim
  pageNumber    Int?    // For papers
  timestamp     String? // For podcasts (e.g., "01:23:45")

  claim         Claim   @relation(fields: [claimId], references: [id], onDelete: Cascade)
  source        Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([claimId, sourceId])
  @@map("claim_sources")
}

model ClaimTheme {
  id        String @id @default(cuid())
  claimId   String
  themeId   String
  relevance Float  @default(1.0)

  claim     Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)
  theme     Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([claimId, themeId])
  @@map("claim_themes")
}

// ============================================================
// Contradiction & Supersession Tracking
// ============================================================
model Contradiction {
  id              String @id @default(cuid())
  claimId         String // The claim making the contradictory assertion
  contradictedId  String // The claim being contradicted
  explanation     String? // AI-generated explanation of the contradiction
  severity        Float  @default(0.5) // 0=minor nuance, 1=direct refutation
  detectedAt      DateTime @default(now())

  claim           Claim  @relation("ClaimContradicts", fields: [claimId], references: [id], onDelete: Cascade)
  contradicted    Claim  @relation("ClaimContradictedBy", fields: [contradictedId], references: [id], onDelete: Cascade)

  @@unique([claimId, contradictedId])
  @@map("contradictions")
}

model Supersession {
  id             String   @id @default(cuid())
  claimId        String   // The newer claim
  supersededId   String   // The older claim it replaces
  explanation    String?
  detectedAt     DateTime @default(now())

  claim          Claim    @relation("ClaimSupersedes", fields: [claimId], references: [id], onDelete: Cascade)
  superseded     Claim    @relation("ClaimSupersededBy", fields: [supersededId], references: [id], onDelete: Cascade)

  @@unique([claimId, supersededId])
  @@map("supersessions")
}

// ============================================================
// FSRS Review System
// ============================================================
model ReviewCard {
  id            String   @id @default(cuid())
  userId        String
  claimId       String
  
  // FSRS state
  due           DateTime @default(now())
  stability     Float    @default(0)
  difficulty    Float    @default(0)
  elapsedDays   Float    @default(0)
  scheduledDays Float    @default(0)
  reps          Int      @default(0)
  lapses        Int      @default(0)
  state         Int      @default(0) // 0=New, 1=Learning, 2=Review, 3=Relearning
  lastReview    DateTime?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  claim         Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  reviewLogs    ReviewLog[]

  @@unique([userId, claimId])
  @@index([userId, due])
  @@index([userId, state])
  @@map("review_cards")
}

model ReviewLog {
  id          String   @id @default(cuid())
  userId      String
  cardId      String
  rating      Int      // 1=Again, 2=Hard, 3=Good, 4=Easy
  reviewedAt  DateTime @default(now())

  // Snapshot of card state before review
  prevStability  Float
  prevDifficulty Float
  prevState      Int
  
  // Card state after review
  newStability   Float
  newDifficulty  Float
  newState       Int
  scheduledDays  Float

  // Review context
  promptType     String?  // "recall" | "reflection" | "correlation"
  responseTimeMs Int?     // How long user took to respond

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  card        ReviewCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@map("review_logs")
}

// ============================================================
// Weekly Digests
// ============================================================
model Digest {
  id          String   @id @default(cuid())
  userId      String
  weekStart   DateTime
  weekEnd     DateTime
  createdAt   DateTime @default(now())

  // Content
  sourcesAdded     Int
  claimsExtracted  Int
  reviewsCompleted Int
  avgRetention     Float?

  // AI-generated
  summary          String?  // Week in review narrative
  keyInsights      String?  // JSON array of insight strings
  contradictions   String?  // JSON array of new contradictions found
  recommendations  String?  // What to review, what to explore

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId])
  @@map("digests")
}

// ============================================================
// Deep Research
// ============================================================
enum DeepResearchStatus {
  PLANNING
  SEARCHING
  EVALUATING
  INGESTING
  GENERATING
  COMPLETE
  FAILED
}

model DeepResearchQuery {
  id            String               @id @default(cuid())
  userId        String
  originalQuery String
  status        DeepResearchStatus   @default(PLANNING)
  createdAt     DateTime             @default(now())
  completedAt   DateTime?
  errorMessage  String?

  subqueries    DeepResearchSubquery[]
  report        DeepResearchReport?
  candidates    DeepResearchCandidate[]

  @@index([userId])
  @@map("deep_research_queries")
}

model DeepResearchSubquery {
  id            String            @id @default(cuid())
  parentQueryId String
  text          String
  rationale     String
  order         Int

  parentQuery   DeepResearchQuery @relation(fields: [parentQueryId], references: [id], onDelete: Cascade)
  candidates    DeepResearchCandidate[]

  @@map("deep_research_subqueries")
}

model DeepResearchReport {
  id        String   @id @default(cuid())
  queryId   String   @unique
  markdown  String
  createdAt DateTime @default(now())

  query     DeepResearchQuery         @relation(fields: [queryId], references: [id], onDelete: Cascade)
  sources   DeepResearchReportSource[]

  @@map("deep_research_reports")
}

model DeepResearchReportSource {
  id             String @id @default(cuid())
  reportId       String
  sourceId       String
  relevanceScore Float
  citationCount  Int

  report  DeepResearchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  source  Source             @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([reportId, sourceId])
  @@map("deep_research_report_sources")
}

// Search hits surfaced for a query (Phase 2). One row per unique candidate
// paper, scored by the evaluator and either ingested, skipped, or flagged as a
// duplicate of an existing Source.
model DeepResearchCandidate {
  id              String   @id @default(cuid())
  queryId         String
  query           DeepResearchQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  subqueryId      String?
  subquery        DeepResearchSubquery? @relation(fields: [subqueryId], references: [id], onDelete: SetNull)
  url             String
  title           String
  abstract        String?  @db.Text
  year            Int?
  citationCount   Int?
  source          String   // 'semantic-scholar' for now; future: 'web'
  relevanceScore  Float?   // 0-1, set by evaluator
  qualityScore    Float?   // 0-1, set by evaluator
  evaluatorNotes  String?  @db.Text
  decision        String   @default("PENDING") // PENDING | INGEST | SKIP | DUPLICATE
  ingestedSourceId String?
  ingestedSource  Source?  @relation(fields: [ingestedSourceId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([queryId])
  @@index([decision])
  @@map("deep_research_candidates")
}

// ============================================================
// Notes — user annotations linked to sources, claims, or themes
// ============================================================
model Note {
  id        String   @id @default(cuid())
  userId    String

  // Content
  title     String?
  content   String

  // Polymorphic linking (at most one, or none for standalone)
  sourceId  String?
  claimId   String?
  themeId   String?
  topic     String?  // Free-form grouping for standalone notes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  source  Source? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  claim   Claim?  @relation(fields: [claimId], references: [id], onDelete: Cascade)
  theme   Theme?  @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sourceId])
  @@index([claimId])
  @@index([themeId])
  @@index([topic])
  @@map("notes")
}
